# Only explicitly maintained project files belong in the public repository.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/Setup.cmd
!/Update-Content.cmd
!/Configure-Server.html
!/Start-Panel.cmd
!/Start-Server.cmd
!/Start-Panel.sh
!/Start-Server.sh
!/START-HERE.txt
!/Setup-Linux.sh
!/docs/
!/scripts/
!/content/

# Keep local credentials, binaries, downloads and runtime data out of Git.
**/.env
**/.env.*
**/*secret*
**/*password*
**/*.local.*
**/users.ini
**/csadmin.cfg
**/server.cfg
**/logs/
**/downloads/
**/backups/
**/_configurator/
**/runtime/
**/*.exe
**/*.dll
**/*.so
**/*.zip
**/*.7z
**/*.rar
**/*.pak
**/*.dem
**/*.sav
**/__pycache__/
**/*.pyc
