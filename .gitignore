# Only explicitly maintained project files belong in the public repository.
/*
!/.gitignore
!/.gitattributes
!/readme.md
!/setup.cmd
!/update-content.cmd
!/update.sh
!/version
!/configure-server.html
!/start-panel.cmd
!/start-server.cmd
!/start-panel.sh
!/start-server.sh
!/start-here.txt
!/setup-linux.sh
!/docs/
!/scripts/
!/content/
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/linux-console.yml

# Keep local credentials, binaries, downloads and runtime data out of Git.
**/.env
**/.env.*
**/*secret*
**/*password*
**/*.local.*
**/users.ini
**/csadmin.cfg
**/server.cfg
**/logs/
**/downloads/
**/backups/
**/_configurator/
**/runtime/
**/*.exe
**/*.dll
**/*.so
**/*.zip
**/*.7z
**/*.rar
**/*.pak
**/*.dem
**/*.sav
**/__pycache__/
**/*.pyc
