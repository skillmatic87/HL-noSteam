# Only explicitly maintained project files belong in the public repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Setup.cmd
!/Update-Content.cmd
!/Setup-Linux.sh
!/docs/
!/scripts/
!/content/

# Keep local credentials, binaries, downloads and runtime data out of Git.
**/.env
**/.env.*
**/*secret*
**/*password*
**/*.local.*
**/users.ini
**/csadmin.cfg
**/server.cfg
**/logs/
**/downloads/
**/backups/
**/runtime/
**/*.exe
**/*.dll
**/*.so
**/*.zip
**/*.7z
**/*.rar
**/*.pak
**/*.dem
**/*.sav
**/__pycache__/
**/*.pyc
